#!/usr/bin/env bash
# Stands in for curl: appends "curl ARGUMENTS" to $FAKE_DOCKER_DIR/calls and answers from its state:
#   llama-health, hindsight-health  the status of :11434/health and :8888/health (default 200); 000
#                                   answers as a refused connection does, with exit 7
#   operations                      the bodies the operations list answers, one per poll and line,
#                                   then {"operations":[]}; a poll's status=pending request takes the
#                                   next line, and each request answers only the operations of its status
#   post-exit                       the exit of a memories POST (default 0); its body goes to posts
#   download-exit                   the exit of the model download (default 0)
#   download-content                the bytes the download appends (default GGUFmodel)
#   content-length                  the Content-Length a HEAD request answers (default none)
#   tailnet-devices                 the Tailscale API's devices, "NODE_ID NAME" per line: a DELETE of
#                                   one in it answers 200 and removes it, of any other 404; the call
#                                   is logged as "curl URL HEADER", the header read from stdin
#   tailnet-status                  present: every Tailscale API call answers this status instead
# A credential on the command line, where every user of the host can read it, exits 99 instead.
set -uo pipefail
state=${FAKE_DOCKER_DIR:?}
for argument in "$@"; do
    case "$argument" in
        *Bearer* | *tskey-*) printf 'curl CREDENTIAL ON ARGV %s\n' "$argument" >>"$state/calls"; exit 99 ;;
    esac
done
url=${!#}
case "$url" in
    https://api.tailscale.com/api/v2/device/*)
        node=${url##*/}
        printf 'curl %s %s\n' "$url" "$(sed -n 's/^header = "\(.*\)"$/\1/p')" >>"$state/calls"
        if [ -e "$state/tailnet-status" ]; then
            status=$(cat "$state/tailnet-status")
            printf '%s' "$status"
            [ "$status" != 000 ] || exit 7
        elif grep -q "^$node " "$state/tailnet-devices" 2>/dev/null; then
            grep -v "^$node " "$state/tailnet-devices" >"$state/tailnet-devices.next"
            mv "$state/tailnet-devices.next" "$state/tailnet-devices"
            printf 200
        else
            printf 404
        fi
        exit 0 ;;
esac
printf 'curl %s\n' "$*" >>"$state/calls"
output=""
previous=""
for argument in "$@"; do
    [ "$previous" != -o ] || output=$argument
    previous=$argument
done

state_value() { cat "$state/$1" 2>/dev/null || echo "$2"; }

answer_status() {
    local status=$1
    printf '%s' "$status"
    [ "$status" != 000 ] || exit 7
}

answer_operations() {
    local status_filter=$1 body
    if [ "$status_filter" = pending ]; then
        body=$(head -n 1 "$state/operations" 2>/dev/null)
        if [ -n "$body" ]; then sed -i 1d "$state/operations"; else body='{"operations":[]}'; fi
        printf '%s\n' "$body" >"$state/operations-poll"
    fi
    python3 -c 'import json, sys
body = json.load(sys.stdin)
print(json.dumps({"operations": [o for o in body.get("operations") or [] if o.get("status") == sys.argv[1]]}))' \
        "$status_filter" <"$state/operations-poll"
}

answer_post() {
    cat >>"$state/posts"
    local exit_code
    exit_code=$(state_value post-exit 0)
    [ "$exit_code" -eq 0 ] || { echo "curl: (22) The requested URL returned error: 500" >&2; exit "$exit_code"; }
}

answer_download() {
    local exit_code
    exit_code=$(state_value download-exit 0)
    if [ "$exit_code" -ne 0 ]; then printf 'GGUFpartial' >>"$output"; exit "$exit_code"; fi
    printf '%s' "$(state_value download-content GGUFmodel)" >>"$output"
}

answer_head() {
    printf 'HTTP/1.1 302 Found\r\nContent-Length: 1\r\n\r\nHTTP/1.1 200 OK\r\n'
    if [ -f "$state/content-length" ]; then printf 'Content-Length: %s\r\n' "$(cat "$state/content-length")"; fi
    printf '\r\n'
}

if [ "${1:-}" = -sIL ]; then answer_head; exit 0; fi
case "$url" in
    *:11434/health) answer_status "$(state_value llama-health 200)" ;;
    *:8888/health) answer_status "$(state_value hindsight-health 200)" ;;
    */operations\?status=*\&limit=100) status_filter=${url##*status=}; answer_operations "${status_filter%%&*}" ;;
    */memories) answer_post ;;
    https://*) answer_download ;;
esac
exit 0
