# ╔═══════════════════════════════════════════════════════════════════════╗
# ║  Hindsight Stack Configuration - edit here, applies to .bat and .sh  ║
# ╚═══════════════════════════════════════════════════════════════════════╝

# false = native Windows llama-server  (3-4x faster on AMD, native Vulkan)
# true  = Docker container             (WSL2 + Vulkan/Dozen for AMD, or CUDA)
DOCKER_LLAMA=true

# GPU backend used in native mode (DOCKER_LLAMA=false only)
# vulkan = AMD  |  cuda = NVIDIA
GPU_TYPE=cuda

# Model
MODEL_FILE=Qwen2.5-7B-Instruct-Q4_K_M.gguf
MODEL_URL=https://huggingface.co/bartowski/Qwen2.5-7B-Instruct-GGUF/resolve/main/Qwen2.5-7B-Instruct-Q4_K_M.gguf
MODEL_ALIAS=qwen2.5:7b

# llama-server flags
LLAMA_PORT=11434
# 32768 = Qwen2.5-7B's full trained context (the model's hard ceiling), so llama never
# rejects a prompt the model can process - no HTTP 400 "exceed_context_size". On the RTX
# 3060's 12GB this fits easily: model ~4.4GB + 32k f16 KV ~1.9GB + buffers ~= 7.5GB.
LLAMA_CTX=32768

# KV-cache precision: f16 (exact, fastest) or q8_0 (half the VRAM). f16 is fine on 12GB.
LLAMA_KV_CACHE_TYPE=f16
LLAMA_NGL=99
LLAMA_PARALLEL=1
LLAMA_THREADS_HTTP=2

# Micro-batch size per GPU dispatch. On CUDA (RTX 3060) prefill is fast and each dispatch
# stays well under the Windows 2s TDR limit even at 512+, so the old AMD/Vulkan throttle
# (256) is unnecessary here. 512 is llama.cpp's default and gives fast prompt eval.
LLAMA_UBATCH_SIZE=512
